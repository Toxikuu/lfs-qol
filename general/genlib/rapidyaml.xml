<sect1 id="rapidyaml" xreflabel="RapidYAML-&rapidyaml-version;">
  <?dbhtml filename="rapidyaml.html"?>

  <title>RapidYAML-&rapidyaml-version;</title>

  <indexterm zone="rapidyaml">
    <primary sortas="a-rapidyaml">RapidYAML</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduction to RapidYAML</title>

    <para>
      The RapidYAML package provides a C++ YAML parser.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Download: <ulink url="&rapidyaml-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">RapidYAML Dependencies</bridgehead>

    <bridgehead renderas="sect4">Required</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installation of RapidYAML</title>

    <para>
      Install RapidYAML by running the following commands:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr   \
      -D CMAKE_BUILD_TYPE=Release    \
      -D BUILD_SHARED_LIBS=ON        \
      -G Ninja .. &amp;&amp;

ninja</userinput></screen>

    <para>
      Now, as the &root; user:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Command Explanations</title>

    <para>
      <parameter>-D BUILD_SHARED_LIBS=ON</parameter>: This parameter forces the
      build system to build shared libraries instead of static ones.
    </para>

  </sect2>

