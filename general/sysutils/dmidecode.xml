<sect1 id="dmidecode" xreflabel="dmidecode-&dmidecode-version;">
  <?dbhtml filename="dmidecode.html"?>

  <title>dmidecode-&dmidecode-version;</title>

  <indexterm zone="dmidecode">
    <primary sortas="a-dmidecode">dmidecode</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduction to dmidecode</title>

    <para>
      The dmidecode package reports information about system hardware as
      described in the BIOS' programmed SMBIOS/DMI data. The information
      contains details of varying levels of reliability, depending on the
      manufacturer.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Download: <ulink url="&dmidecode-download;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installation of dmidecode</title>

    <para>
      Modify the documentation directory so that it is a versioned directory:
    </para>

<screen><userinput>sed -i 's|/doc/dmidecode|&amp;-&dmidecode-version;|' Makefile
</userinput></screen>

    <para>
      Install dmidecode by running the following command:
    </para>

<screen><userinput>make prefix=/usr</userinput></screen>

    <para>
      Now, as the &root; user:
    </para>

<screen role="root"><userinput>make prefix=/usr install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Contents</title>

    <segmentedlist>
      <segtitle>Installed Programs</segtitle>
      <segtitle>Installed Libraries</segtitle>
      <segtitle>Installed Directories</segtitle>

      <seglistitem>
        <seg>
          biosdecode, dmidecode, ownership, vpddecode
        </seg>
        <seg>
          None
        </seg>
        <seg>
          /usr/share/doc/dmidecode-&dmidecode-version;
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Short Descriptions</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="biosdecode-bin">
        <term><command>biosdecode</command></term>
        <listitem>
          <para>
            is a tool which prints all BIOS related information it can find
            in /dev/mem
          </para>
          <indexterm zone="dmidecode biosdecode-bin">
            <primary sortas="b-biosdecode-bin">biosdecode</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="dmidecode-bin">
        <term><command>dmidecode</command></term>
        <listitem>
          <para>
            is a DMI table decoder
          </para>
          <indexterm zone="dmidecode dmidecode-bin">
            <primary sortas="b-dmidecode-bin">dmidecode</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="ownership-bin">
        <term><command>ownership</command></term>
        <listitem>
          <para>
            prints the "ownership tag" that can be set on Compaq computers
          </para>
          <indexterm zone="dmidecode ownership-bin">
            <primary sortas="b-ownership-bin">ownership</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="vpddecode-bin">
        <term><command>vpddecode</command></term>
        <listitem>
          <para>
            prints the contents of the "vital product data" structure as
            found in most IBM and Lenovo computers
          </para>
          <indexterm zone="dmidecode vpddecode-bin">
            <primary sortas="b-vpddecode-bin">vpddecode</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

</sect1>
